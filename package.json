{
  "name": "lovelystep",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run build",
    "lint": "eslint . --ignore-pattern .next",
    "ai:test-providers": "node --env-file=.env.local scripts/check-ai-providers.mjs",
    "ai:test-import": "node --env-file=.env.local scripts/e2e-ai-import.mjs",
    "background:setup": "node scripts/setup-background-removal.mjs",
    "test:product-overlay": "node scripts/test-product-overlay.mjs",
    "test:order-flow": "node scripts/test-order-flow.mjs",
    "test:store-features": "node scripts/test-store-features.mjs",
    "test:finance": "node --env-file=.env.local scripts/test-financial-foundation.mjs",
    "test:meta": "node --env-file=.env.local scripts/test-meta-tracking.mjs",
    "test:meta-ads": "node --env-file=.env.local scripts/test-meta-ads-catalog.mjs",
    "test:kpis": "node --experimental-strip-types --import ./scripts/ts-resolve-hook.mjs scripts/test-finance-kpis.mjs",
    "test:attribution": "node --experimental-strip-types --import ./scripts/ts-resolve-hook.mjs scripts/test-attribution.mjs",
    "test:integration": "node --experimental-strip-types --import ./scripts/ts-resolve-hook.mjs scripts/test-meta-integration.mjs",
    "test:privacy": "node --env-file=.env.local scripts/test-privacy.mjs",
    "test:csrf": "node --experimental-strip-types --import ./scripts/ts-resolve-hook.mjs scripts/test-csrf-origin.mjs",
    "test:free-shipping": "node --experimental-strip-types --import ./scripts/ts-resolve-hook.mjs scripts/test-free-shipping.mjs",
    "test:zrexpress-contract": "node --experimental-strip-types --import ./scripts/ts-resolve-hook.mjs scripts/test-zrexpress-contract.mjs",
    "test:all": "npm run test:kpis && npm run test:attribution && npm run test:integration && npm run test:csrf && npm run test:free-shipping && npm run test:zrexpress-contract",
    "security:test-client-secrets": "node --env-file=.env.local scripts/check-client-secrets.mjs",
    "db:migrate:supabase": "node --env-file=.env.local scripts/migrate-sqlite-to-postgres.mjs",
    "media:migrate:supabase": "node --env-file=.env.local scripts/migrate-media-to-supabase.mjs",
    "supabase:verify": "node --env-file=.env.local scripts/verify-supabase.mjs",
    "zrexpress:test": "node --env-file=.env.local scripts/check-zrexpress.mjs",
    "1688:login": "node scripts/1688-login.mjs"
  },
  "dependencies": {
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "better-sqlite3": "13.0.3",
    "next": "16.3.0",
    "pg": "^8.23.0",
    "playwright": "1.62.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.3.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.19",
    "@types/pg": "^8.21.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "type": "module"
}
