# URL publique de la boutique. Laissez localhost pour travailler en local.
# Lue à l'exécution : elle détermine les liens du catalogue Meta et l'indicateur secure des
# cookies de session, donc une valeur figée au build serait corrigée sans effet.
SITE_URL=http://localhost:3000
# Ancien nom, conservé comme repli. À éviter : Next fige toute variable NEXT_PUBLIC_*
# au moment du `next build`.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chemin facultatif de la base SQLite.
# DATABASE_PATH=C:\chemin\vers\lovelystep.db
# Production PostgreSQL (utilisez le Session pooler Supabase, jamais une clé publique).
DATABASE_URL=
DATABASE_POOL_SIZE=5
# DATABASE_SSL=disable

# Stockage d'images Supabase (la clé service_role reste strictement côté serveur).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY= # ancienne clé, également acceptée
SUPABASE_STORAGE_BUCKET=product-media

# Sur un hébergement HTTPS, utilisez true.
COOKIE_SECURE=false

# Livraison offerte à partir de ce sous-total d'articles (en DZD).
# Si la variable manque ou est invalide, le code utilise 12000 DA.
FREE_SHIPPING_THRESHOLD_DZD=12000

# Import IA par captures d’écran. Ne préfixez jamais ces clés par NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
# Dedicated campaign-explanation model. This remains server-only and may be changed independently.
CAMPAIGN_AI_MODEL=llama-3.3-70b-versatile
CAMPAIGN_AI_TIMEOUT_MS=12000
CAMPAIGN_AI_CACHE_HOURS=12

# === Meta : Pixel navigateur + Conversions API ===
# Le suivi reste totalement désactivé tant que META_TRACKING_ENABLED n'est pas "true".
META_TRACKING_ENABLED=false

# Identifiant du Pixel. Lu à l'exécution, donc modifiable sans reconstruire.
# Le serveur le transmet au navigateur en prop : aucun code client ne lit l'environnement.
META_PIXEL_ID=
# Ancien nom, conservé comme repli. À éviter : Next fige toute variable NEXT_PUBLIC_*
# au moment du `next build`, donc une valeur ajoutée après coup n'est jamais prise en compte.
NEXT_PUBLIC_META_PIXEL_ID=
# Dataset Conversions API. Vide = on réutilise le Pixel ci-dessus.
META_DATASET_ID=
# Jeton système, strictement côté serveur. Ne jamais préfixer par NEXT_PUBLIC_.
META_ACCESS_TOKEN=

# Version Graph API épinglée. Défaut du code : v26.0 (courante au 2026-08-10).
# Meta publie une version par trimestre et retire chacune après environ deux ans.
# Revérifiez https://developers.facebook.com/docs/graph-api/changelog avant chaque mise à jour.
META_GRAPH_API_VERSION=v26.0

# Code Test Events. Ignoré en production : il ne doit jamais toucher le trafic réel.
META_TEST_EVENT_CODE=

# Ads Insights et catalogue produit.
# META_AD_ACCOUNT_ID accepte "act_123456789" ou "123456789".
META_AD_ACCOUNT_ID=
META_CATALOG_ID=
META_BUSINESS_ID=

# Application Meta : nécessaire uniquement si vous générez les jetons via OAuth.
# Un jeton d'utilisateur système suffit pour cette boutique mono-magasin.
META_APP_ID=
META_APP_SECRET=

# === Automatisation catalogue + Page Facebook ===
# Synchronise immédiatement le catalogue à chaque enregistrement de produit. Le cron reste le
# filet de sécurité qui retente les échecs et rattrape les changements manqués.
META_AUTO_CATALOG_SYNC_ENABLED=false
# Publication unique lors du premier passage d'un produit au statut "published".
META_AUTO_POST_ENABLED=false
# Identifiant numérique de la Page Facebook, pas celui du Business Portfolio.
META_PAGE_ID=
# Jeton d'accès de Page avec pages_manage_posts et pages_read_engagement.
# pages_show_list est nécessaire pendant le parcours servant à sélectionner/générer ce jeton.
META_PAGE_ACCESS_TOKEN=
# Publie le même produit sur le compte Instagram professionnel relié à la Page Facebook.
# Le jeton de Page doit aussi inclure instagram_basic et instagram_content_publish.
META_INSTAGRAM_AUTO_POST_ENABLED=false
# ID numérique du compte professionnel retourné par instagram_business_account.id.
META_INSTAGRAM_ACCOUNT_ID=

# === WhatsApp Cloud API — confirmation gratuite initiée par le client ===
# Numéro public au format international, sans espaces (ex. 213555123456).
WHATSAPP_BUSINESS_NUMBER=
# Identifiants fournis dans Meta Developers > WhatsApp > Configuration API.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Secret long choisi par vous pour la validation initiale du webhook.
WHATSAPP_VERIFY_TOKEN=
# Facultatif si META_APP_SECRET contient le secret de la même application Meta.
WHATSAPP_APP_SECRET=
# Vide = réutilise META_GRAPH_API_VERSION.
WHATSAPP_GRAPH_API_VERSION=v26.0

# Secret partagé du planificateur, pour POST /api/cron/meta-sync.
# Sans cette variable, l'endpoint reste fermé. Générez une valeur aléatoire longue.
CRON_SECRET=

# Rétention des données de suivi, en jours. Les données comptables ne sont jamais purgées.
RETENTION_VISITS_DAYS=180
RETENTION_META_EVENTS_DAYS=180
RETENTION_ATTRIBUTION_DAYS=400

# Garde-fou : une migration ne doit jamais s'exécuter pendant `next build`.
# Ne passez à true que pour une étape de migration délibérée.
# ALLOW_BUILD_TIME_MIGRATION=false

# Clé privée du transporteur. Le nom doit correspondre au champ configuré dans Administration → Livraison.
DELIVERY_API_TOKEN=

# ZR Express — clé privée et identifiant X-Tenant. Ne jamais préfixer par NEXT_PUBLIC_.
ZREXPRESS_API_KEY=
ZREXPRESS_TENANT_ID=
# Poids utilisé si le produit ne possède pas encore de poids logistique.
ZREXPRESS_DEFAULT_WEIGHT_KG=1

# Suppression d’arrière-plan locale avant l’overlay produit.
BACKGROUND_REMOVAL_MODEL=birefnet-general-lite
# Laissez false pour les vêtements : cela évite le halo flou autour du produit.
BACKGROUND_REMOVAL_ALPHA_MATTING=false
# BACKGROUND_REMOVAL_PYTHON=C:\chemin\vers\python.exe
# BACKGROUND_REMOVAL_THREADS=4
